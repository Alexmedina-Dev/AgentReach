{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentreach-reporte-html-datos-v1",
  "title": "AgentReach HTML report data (schema_version 1)",
  "description": "Content of <script type=application/json id=data> in plantilla.html. Text for people comes in {en, es}. No field can hold a secret value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "folder",
    "files_looked_at",
    "secrets_notice",
    "agents",
    "catalog",
    "not_reviewed",
    "limits",
    "limits_also"
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 1200
        },
        "es": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "shownPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1100,
      "description": "Path already relative with '/', dangerous characters written as \\uXXXX (reporting/limpieza.py), cut at 1000 characters with a mark."
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]{1,64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "line",
        "type",
        "provider",
        "level",
        "reason",
        "unrelated",
        "agent",
        "posture",
        "rule",
        "source_verified",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "path": {
          "$ref": "#/$defs/shownPath"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "null = 'line not determined' (Linea.NO_DETERMINADA). Never 0."
        },
        "type": {
          "type": "string",
          "pattern": "^TH-[0-9]{1,3}$",
          "description": "Key of catalog.types"
        },
        "provider": {
          "$ref": "#/$defs/code",
          "description": "Key of catalog.providers (Proveedor.value)"
        },
        "level": {
          "enum": [
            "verified",
            "potential",
            "hypothesis"
          ]
        },
        "reason": {
          "$ref": "#/$defs/code",
          "description": "Key of catalog.reasons (Motivo.value)"
        },
        "unrelated": {
          "enum": [
            "si",
            "no",
            "no_determinado"
          ],
          "description": "Ajeno.value; key of catalog.unrelated"
        },
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "Finding.agente (Etiqueta) or null"
        },
        "posture": {
          "enum": [
            "allow",
            "ask",
            "deny",
            "sin_regla",
            "no_determinada"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1100,
          "description": "'file:line' of the rule that decides the posture, shown path"
        },
        "source_verified": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "pattern": "^TH-[0-9]{1,3}(/[a-z_]+)?$",
          "description": "Key of catalog.texts (the TH-17 meaning changes with 'unrelated')"
        }
      }
    },
    "agentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "findings",
        "rules",
        "env_cleaning"
      ],
      "properties": {
        "id": {
          "enum": [
            "claude_code",
            "opencode",
            "none"
          ],
          "description": "Plataforma.value; 'none' = findings not tied to one agent (NO_DETERMINADA)"
        },
        "name": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "$ref": "#/$defs/i18n"
            }
          ]
        },
        "env_cleaning": {
          "type": "boolean"
        },
        "not_determined": {
          "type": "array",
          "maxItems": 200,
          "description": "Why some findings of this agent have level 'not determined': the file and the KEY AgentReach does not interpret (never a value). Empty when none is.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {"$ref": "#/$defs/shownPath"},
              "key": {"type": "string", "maxLength": 80},
              "reason": {"type": "string"}
            }
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "posture",
              "tool",
              "location"
            ],
            "properties": {
              "posture": {
                "enum": [
                  "allow",
                  "ask",
                  "deny",
                  "no_determinada"
                ]
              },
              "tool": {
                "type": "string",
                "maxLength": 1000
              },
              "location": {
                "type": "string",
                "maxLength": 1100
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool": {
      "type": "string",
      "maxLength": 64
    },
    "tool_version": {
      "type": "string",
      "maxLength": 32
    },
    "generated_at": {
      "type": "string",
      "maxLength": 40,
      "description": "Injected clock (parameter 'ahora'), same text for the same clock."
    },
    "folder": {
      "$ref": "#/$defs/shownPath"
    },
    "files_looked_at": {
      "type": "integer",
      "minimum": 0
    },
    "secrets_notice": {
      "$ref": "#/$defs/i18n"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/agentEntry"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types",
        "texts",
        "reasons",
        "providers",
        "postures",
        "unrelated",
        "no_review"
      ],
      "properties": {
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "meaning",
              "what_to_do"
            ],
            "properties": {
              "meaning": {
                "$ref": "#/$defs/i18n"
              },
              "what_to_do": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/i18n"
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/i18n"
          }
        },
        "postures": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/i18n"
          }
        },
        "unrelated": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/i18n"
          }
        },
        "no_review": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "title",
              "how_to_fix"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/i18n"
              },
              "how_to_fix": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        }
      }
    },
    "not_reviewed": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/shownPath"
          },
          "reason": {
            "enum": [
              "ubicacion_sensible_sin_activar",
              "archivo_ilegible",
              "archivo_demasiado_grande",
              "no_es_archivo_regular",
              "codificacion_no_utf8",
              "profundidad_excedida",
              "ruta_de_red",
              "configuracion_no_interpretable",
              "version_no_reconocida",
              "historial_git_fase2",
              "funcion_no_modelada",
              "sin_permiso_fuera_del_proyecto"
            ]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1200
          }
        },
        "es": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1200
          }
        }
      }
    },
    "limits_also": {
      "$ref": "#/$defs/i18n"
    },
    "glossary": {
      "type": "object",
      "description": "Optional (Story 33). Text of 'How to read this report': the 12 fixed term cards of core/catalogo_terminos.py, Spanish with the chosen tone (tu/usted) and English. No values, no paths.",
      "additionalProperties": false,
      "required": [
        "labels",
        "terms"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what_is",
            "means",
            "to_do"
          ],
          "properties": {
            "what_is": {
              "$ref": "#/$defs/i18n"
            },
            "means": {
              "$ref": "#/$defs/i18n"
            },
            "to_do": {
              "$ref": "#/$defs/i18n"
            }
          }
        },
        "terms": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "line",
              "what_is",
              "means",
              "to_do"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z_]{1,40}$"
              },
              "name": {
                "$ref": "#/$defs/i18n"
              },
              "line": {
                "$ref": "#/$defs/i18n"
              },
              "what_is": {
                "$ref": "#/$defs/i18n"
              },
              "means": {
                "$ref": "#/$defs/i18n"
              },
              "to_do": {
                "$ref": "#/$defs/i18n"
              }
            }
          }
        }
      }
    },
    "initial_language": {
      "enum": [
        "en",
        "es"
      ],
      "description": "Language the file opens with (--idioma); the reader can still switch."
    },
    "configured_agents": {
      "type": "array",
      "description": "Agents (and frameworks) whose configuration files EXIST (configured, never 'executed'). Evidence is paths and variable NAMES only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,60}$"},
          "name": {"type": "string"},
          "kind": {"enum": ["agent", "framework"]},
          "confidence": {"enum": ["high", "potential", "hypothesis"], "description": "hypothesis = only a hint ('indicio')"},
          "analyzed": {"type": "boolean", "description": "AgentReach analyzes what this agent can reach (it has an adapter); otherwise it only says it is configured"},
          "on": {"type": "array", "items": {"type": "string"}, "description": "frameworks: names of the agents they are installed on"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "path"],
              "properties": {
                "scope": {"enum": ["project", "user", "environment"]},
                "path": {"$ref": "#/$defs/shownPath"}
              }
            }
          }
        }
      }
    },
    "undetermined_traces": {
      "type": "array",
      "description": "Shared traces (e.g. AGENTS.md) that do not say which of several agents uses them. Shown as 'not determined' with the candidates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "candidates"],
        "properties": {
          "path": {"$ref": "#/$defs/shownPath"},
          "candidates": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
